# Calliope Poker configuration.
#
# Copy this file to .env and edit it. Docker Compose reads .env automatically,
# so `docker compose up -d` picks up everything below with no extra flags.
#
#     cp .env.example .env
#
# Every setting has a working default, so an unedited copy runs fine on your
# own machine. Never commit .env itself; it is in .gitignore for that reason.


# ---------------------------------------------------------------------------
# Where people reach you
# ---------------------------------------------------------------------------

# Leave this blank. Join links, and the QR code in the lobby, are then built
# from the address each browser is already using, so if you opened the site at
# http://192.168.1.50:8080 that is exactly what you hand out. That is right for
# a home network, and a wrong value here is worse than none: it gives everyone
# a link to a machine that is not yours.
#
# Set it only when your guests reach the server at a different address than you
# do, such as behind a reverse proxy or on a real domain. Include the port
# unless the proxy is on 80 or 443, and no trailing slash.
PUBLIC_URL=

# The port the app listens on.
WEB_PORT=8080


# ---------------------------------------------------------------------------
# Who is allowed to open a table
# ---------------------------------------------------------------------------

# Leave this blank and anybody who can reach the server can open a table.
# Set it and only people who have entered the key can, which is what you want
# if the server is reachable from the internet.
#
# It does not shut anyone out of the game: guests can still pick a name, follow
# your link or type your room code, sit down and play. They just cannot open
# tables of their own.
#
# You claim it once. Open the site, choose "I run this server" on the landing
# page, and paste the key. The permission then belongs to your identity and
# follows your five-word ticket to any other device, so you only do it once.
#
# Make one with:   openssl rand -base64 24
#
# The server says which mode it is in at startup, so an open instance is never
# a surprise.
HOST_KEY=


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Careful: POSTGRES_PASSWORD only takes effect the first time the database
# volume is created. Editing it later does NOT change the real password, and
# the app will then fail to connect. To change it, wipe the data at the same
# time:
#
#     docker compose down -v      # deletes all identities, nights and hands
#     docker compose up -d
#
# Postgres is published on 127.0.0.1 only, so it is not reachable from outside
# this machine.
POSTGRES_USER=calliope
POSTGRES_PASSWORD=change-me
POSTGRES_DB=calliope


# ---------------------------------------------------------------------------
# Only needed when running the server outside Docker
# ---------------------------------------------------------------------------

# Docker Compose sets these itself for the app container, so you can ignore
# this whole section unless you run `npm run dev:server` on your machine
# against the two containers. Keep the password in DATABASE_URL matching
# POSTGRES_PASSWORD above.

PORT=3000
DATABASE_URL=postgres://calliope:change-me@localhost:5432/calliope
REDIS_URL=redis://localhost:6379

# The ports the two containers publish on 127.0.0.1 for the above to work.
# Change them only if something else on your machine already uses 5432 or 6379.
POSTGRES_PORT=5432
REDIS_PORT=6379

